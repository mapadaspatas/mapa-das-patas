# ==============================================================================
# Mapa das Patas - Variáveis de Ambiente (.env.example)
# ==============================================================================
# Copie este arquivo para .env ao rodar localmente ou configure no Cloudflare Pages.
# Em desenvolvimento local quase todas as variáveis são opcionais (o sistema usa mocks).
# A exceção é CONFIRMATION_SECRET: ele não é simulado nem em dev, de propósito.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Configurações Públicas do Frontend (Nuxt RuntimeConfig)
# ------------------------------------------------------------------------------

# URL base absoluta do site (usada para meta tags, og:image e compartilhamento)
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Site Key pública do Cloudflare Turnstile (anti-spam do formulário de cadastro)
# A chave abaixo é a chave de teste oficial da Cloudflare (sempre passa sem desafio)
# Produção: gere no painel Cloudflare Turnstile
NUXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# ID do site no Umami Analytics (coleta cookieless de cliques em PIX, buscas, etc.)
# Opcional em desenvolvimento. Em produção, obtenha em cloud.umami.is
NUXT_PUBLIC_UMAMI_WEBSITE_ID=

# Host do Umami Analytics (padrão: https://cloud.umami.is ou URL da sua instância)
NUXT_PUBLIC_UMAMI_HOST_URL=https://cloud.umami.is

# Link do dashboard público compartilhado do Umami (opcional, exibe link no rodapé)
# Exemplo: https://cloud.umami.is/share/SEU_TOKEN_PUBLICO/mapa-das-patas
NUXT_PUBLIC_UMAMI_PUBLIC_URL=

# ------------------------------------------------------------------------------
# 2. Secrets das Funções Serverless (functions/api/cadastro.ts e confirmacao.ts)
# ------------------------------------------------------------------------------
# ATENÇÃO: Nunca compartilhe ou commite estes valores. Configure como Secrets
# no painel do Cloudflare Pages (Settings -> Environment variables).

# Token de acesso do GitHub (Fine-grained Personal Access Token)
# Permissões necessárias: Contents (Read & Write) e Pull requests (Read & Write)
# Em desenvolvimento local sem token, o endpoint simula a abertura do PR no console.
GITHUB_TOKEN=

# Repositório de destino dos Pull Requests de cadastro no formato usuario/repo
# Exemplo: seu-usuario/mapa-das-patas
GITHUB_REPO=

# Secret Key do Cloudflare Turnstile para validação no backend
# Produção: gerada junto com a Site Key no painel do Cloudflare Turnstile
TURNSTILE_SECRET=

# Branch base para onde os Pull Requests de cadastro serão abertos (padrão: main)
BRANCH_BASE=main

# Segredo do HMAC dos links de confirmação (/confirmar/<slug>), usado por
# functions/api/confirmacao.ts e por `pnpm token <slug> <canal>`.
# Gere um valor longo e aleatório, por exemplo:
#   node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
# Sem ele, NENHUM token vale (falha fechada) — inclusive em desenvolvimento, de
# propósito: é o mesmo comportamento de produção. Trocá-lo invalida de uma vez
# todos os links já enviados que ainda não foram clicados.
CONFIRMATION_SECRET=

# ------------------------------------------------------------------------------
# 3. Configuração de Build do Cloudflare Pages
# ------------------------------------------------------------------------------
# Versão do Node.js usada no ambiente de build do Cloudflare Pages
NODE_VERSION=24
